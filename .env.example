# Только для локального демо. Не публикуйте реальные ключи в Git.
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ADMIN_KEY=change-this-demo-key
APP_PUBLIC=0

# Для MAX после создания бота. Для make max-demo можно не задавать: токен будет запрошен скрыто.
MAX_BOT_TOKEN=
MAX_MINIAPP_URL=
# Опционально: путь к своему PEM-файлу с доверенным CA для API MAX.
MAX_CA_BUNDLE=
# Только для режима webhook:
MAX_WEBHOOK_SECRET=
